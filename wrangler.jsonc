{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-interviewer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  // keep_vars preserves dashboard variables (e.g. PERSONAL_DATA_COLLECTION_APPROVED) across deploys.
  "keep_vars": true,
  "vars": { "BETTER_AUTH_URL": "https://ai-interviewer.jack-cao.workers.dev" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "737f5774922a4f44bdd83817b62a9ab3" }],
  // Hosted runner (runner/hosted.wrangler.jsonc). env.runner rebinds it to the local Docker proxy.
  "services": [{ "binding": "PYTHON_RUNNER", "service": "ai-interviewer-python-runner" }],
  "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "VoiceSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceSession"] }],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "ai-interviewer-review"
      }
    ],
    "consumers": [
      {
        "queue": "ai-interviewer-review"
      }
    ]
  },
  "env": {
    "runner": {
      "services": [{ "binding": "PYTHON_RUNNER", "service": "ai-interviewer-python-runner" }],
      "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "VoiceSession" }] },
      "queues": {
        "producers": [{ "binding": "REVIEW_QUEUE", "queue": "ai-interviewer-review" }],
        "consumers": [{ "queue": "ai-interviewer-review" }]
      }
    }
  }
}
