{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-interviewer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build:browser" },
  "assets": {
    "directory": "./public",
    // src/worker.ts serves every non-API path through this binding.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // keep_vars preserves dashboard variables (e.g. PERSONAL_DATA_COLLECTION_APPROVED) across deploys.
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "vars": {
    "BETTER_AUTH_URL": "https://ai-interviewer.jack-cao.workers.dev",
    "LANDING_PRIMARY_ACTION": "personal_practice",
    "WAITLIST_COLLECTION_APPROVED": "true",
    "WAITLIST_POLICY": "{\"version\":\"waitlist-2026-09-30.2\",\"contactPurpose\":\"Optional invitations to new Coursay practice features and voluntary product feedback. Joining is not required for current personal practice.\",\"operator\":\"Jack Cao\",\"contact\":\"jack.cao@utdallas.edu\",\"retention\":\"Entries are retained until withdrawal, the contact purpose is fulfilled, or the waitlist closes, whichever occurs first. Anonymous signup and withdrawal outcomes are retained until project retirement.\",\"processors\":\"Cloudflare hosts the application; Neon PostgreSQL stores waitlist records. Operator access is restricted to Jack Cao. Waitlist data is not sent to AI models and never enters measurement. Optional first-party measurement is described in the privacy notice.\",\"deletion\":\"Use the original receipt to delete your entry, or contact jack.cao@utdallas.edu for access, export or deletion. Jack Cao deletes entries when their purpose is fulfilled or the waitlist closes. Deleted entries may remain in Neon recovery history until its configured expiry (currently 6 hours). Before a restored database is used, restored waitlist entries are erased and fresh opt-in is required.\",\"emailProvider\":\"none\",\"confirmation\":\"browser_receipt\"}"
  },
  // Per-visitor limits for Site collection writes: forms (waitlist, feedback, bug reports) and
  // measurement. Cloudflare counts each connecting IP address in memory for one minute;
  // the application never stores it.
  "ratelimits": [
    { "name": "FORM_VISITOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MEASURE_VISITOR_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "737f5774922a4f44bdd83817b62a9ab3" }],
  // Reviews and text-mode interviewer replies (src/llm.ts). Always remote, even in wrangler dev.
  "ai": { "binding": "AI", "remote": true },
  // Hosted runner (runner/hosted.wrangler.jsonc). env.runner rebinds it to the local Docker proxy.
  "services": [{ "binding": "PYTHON_RUNNER", "service": "ai-interviewer-python-runner" }],
  "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "VoiceSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceSession"] }],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "ai-interviewer-review"
      }
    ],
    // One review per invocation: each makes a model call of up to several minutes.
    "consumers": [
      {
        "queue": "ai-interviewer-review",
        "max_batch_size": 1
      }
    ]
  },
  "env": {
    "runner": {
      "services": [{ "binding": "PYTHON_RUNNER", "service": "ai-interviewer-python-runner" }],
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "VoiceSession" }] },
      "queues": {
        "producers": [{ "binding": "REVIEW_QUEUE", "queue": "ai-interviewer-review" }],
        "consumers": [{ "queue": "ai-interviewer-review", "max_batch_size": 1 }]
      }
    }
  }
}
