{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-interviewer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "VoiceSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceSession"] }],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "ai-interviewer-review"
      }
    ],
    "consumers": [
      {
        "queue": "ai-interviewer-review"
      }
    ]
  }
}
