# Copy to repository-root .env.marketing.local (gitignored). Never put keys in chat.
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
# Choose the host matching the Alibaba key's region/workspace.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# Set true only after verifying free quota/coupon coverage in the provider console.
# This records operator confirmation; it cannot enforce provider billing settings.
GEMINI_COVERED_USAGE_CONFIRMED=false
DASHSCOPE_COVERED_USAGE_CONFIRMED=false
# Monid is used exclusively for Jev; its CLI manages authentication separately.
EXA_API_KEY=
FIRECRAWL_API_KEY=
QWEN_COVERED_USAGE_CONFIRMED=false
# Absolute path to the installed @monid-ai/cli/dist/index.js entry (not a key).
MONID_CLI_PATH=
