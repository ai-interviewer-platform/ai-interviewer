# Local development is generated by `npm run db:local:setup` in `.dev.vars`.
DATABASE_URL=postgresql://ai_interviewer_app:replace-me@127.0.0.1:5433/ai_interviewer
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# `wrangler dev` uses this local database for the HYPERDRIVE binding; it reads
# the value from `.env`, not `.dev.vars`. `npm run db:local:setup` writes it.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://ai_interviewer_app:replace-with-the-local-password@127.0.0.1:5433/ai_interviewer

# Keep this false until retention, deletion, disclosure, and processor handling
# have been approved for the deployment.
PERSONAL_DATA_COLLECTION_APPROVED=false

# Optional: password reset and email verification through Resend. Both must be
# set to turn them on; then new accounts must confirm their email before sign-in.
# Store RESEND_API_KEY as a Worker secret. EMAIL_FROM needs a verified Resend
# sender domain, for example `Coursay <no-reply@your-domain>`.
RESEND_API_KEY=
EMAIL_FROM=

# Deepgram Voice Agent handles listening and speech. Its managed OpenAI provider
# uses gpt-5.6-terra for thinking, so no browser or OpenAI key is exposed.
DEEPGRAM_API_KEY=

# Reviews use a provider adapter (src/review-provider.ts). Leave
# REVIEW_PROVIDER empty to use Workers AI (the `AI` binding in wrangler.jsonc, no
# key; `wrangler dev` calls the real, billed service), or set it to
# `openai-responses` with the key and model below. Do not commit provider API keys.
# Text-mode interviewer replies always use the Workers AI binding.
REVIEW_PROVIDER=
REVIEW_PROVIDER_API_KEY=
REVIEW_PROVIDER_MODEL=

# Production may use the PYTHON_RUNNER service binding instead. A remote runner
# must be a fixed HTTPS endpoint with a server-held bearer token.
PYTHON_RUNNER_URL=
PYTHON_RUNNER_TOKEN=
